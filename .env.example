# Copiez ce fichier en « .env » et renseignez vos identifiants MySQL.
# Sous WampServer, le serveur écoute sur 127.0.0.1:3306.

PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cashevent_school

# Clé de signature des sessions : mettez une longue chaîne aléatoire.
JWT_SECRET=changez-cette-cle-en-production
JWT_DUREE=7d

NIVEAU=2ᵉ année Bac — Sciences

# Génération des exercices corrigés (facultatif en développement).
# Assistant (exercices corrigés). OpenRouter propose des modèles gratuits :
# créez une clé sur https://openrouter.ai/keys et collez-la ici.
OPENROUTER_API_KEY=
# Modèle gratuit par défaut ; d'autres sont essayés s'il sature (IA_MODELES_SECOURS).
IA_MODELE=nvidia/nemotron-3-super-120b-a12b:free
# Anthropic reste possible : laissez OPENROUTER_API_KEY vide et renseignez ceci.
ANTHROPIC_API_KEY=

# Copiez ce fichier en « .env » et renseignez vos identifiants MySQL.
# Sous WampServer, le serveur écoute sur 127.0.0.1:3306.

PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cashevent_school

# Clé de signature des sessions : mettez une longue chaîne aléatoire.
JWT_SECRET=changez-cette-cle-en-production
JWT_DUREE=7d

NIVEAU=2ᵉ année Bac — Sciences

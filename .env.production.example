# Cashevent School — configuration de production
# Copiez ce fichier en « .env » sur le serveur, puis renseignez chaque valeur.
# Ce fichier ne doit jamais être versionné : .gitignore exclut déjà « .env ».

NODE_ENV=production

# PORT : à ne définir que sur un serveur dont vous choisissez le port.
# Sur un hébergement (Hostinger, Render, Railway…) le port est imposé par la
# plateforme et l'application le lit toute seule — ne le forcez pas.

# ------------------------------------------------------------------ Base de données
# Créez un compte dédié, limité à cette seule base :
#   CREATE DATABASE cashevent_school CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'cashevent'@'localhost' IDENTIFIED BY 'un-mot-de-passe-long-et-aleatoire';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON cashevent_school.* TO 'cashevent'@'localhost';
#   FLUSH PRIVILEGES;
# Le compte a besoin de CREATE et ALTER au premier démarrage, puis vous pouvez
# les retirer.
#
# Sur un hébergement mutualisé, créez la base depuis le panneau d'administration
# et reportez ici le nom, l'utilisateur et le mot de passe fournis. Inutile de
# lancer quoi que ce soit ensuite : si la base est vide, l'application y installe
# elle-même le schéma, le catalogue et les cours au premier démarrage.
DB_HOST=localhost
DB_PORT=3306
DB_USER=cashevent
DB_PASSWORD=
DB_NAME=cashevent_school

# ------------------------------------------------------------------ Sessions
# Clé de signature des jetons. Générez-la et ne la partagez pas :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# La changer déconnecte immédiatement tout le monde.
JWT_SECRET=
JWT_DUREE=7d

# ------------------------------------------------------------------ Contenu
NIVEAU=2ᵉ année Bac — Sciences
